# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (e.g. https://your-app.onrender.com)
# On Render, RENDER_EXTERNAL_HOSTNAME is auto-injected as fallback.
APP_URL="MY_APP_URL"

# PORT: The port the server listens on. Render injects this automatically.
# PORT=10000

# PLAID_CLIENT_ID: Client ID for Plaid real-time banking API integration
PLAID_CLIENT_ID=

# PLAID_SECRET: Secret key for Plaid real-time banking API
PLAID_SECRET=

# PLAID_ENV: Plaid environment (sandbox, development, or production)
PLAID_ENV=sandbox

# SETU_CLIENT_ID: Client ID for India Account Aggregator (AA) Open Financial Data API
SETU_CLIENT_ID=

# SETU_CLIENT_SECRET: Secret for India Account Aggregator (AA) Open Financial Data API
SETU_CLIENT_SECRET=

# GOOGLE_CLIENT_ID: OAuth2 Client ID for Google Login
GOOGLE_CLIENT_ID=

# GOOGLE_CLIENT_SECRET: OAuth2 Client Secret for Google Login
GOOGLE_CLIENT_SECRET=

# GITHUB_CLIENT_ID: OAuth2 Client ID for GitHub Login
GITHUB_CLIENT_ID=

# GITHUB_CLIENT_SECRET: OAuth2 Client Secret for GitHub Login
GITHUB_CLIENT_SECRET=

# --- Firebase Configuration ---
# Copy these values from your Firebase Console > Project Settings
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_FIRESTORE_DATABASE_ID=(default)
